# =========================================================================
# APNAKART - PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# =========================================================================

# -------------------------------------------------------------------------
# 1. Node & Server Settings
# -------------------------------------------------------------------------
PORT=5000
NODE_ENV=production
BACKEND_URL=https://api.apnakart.com
FRONTEND_URL=https://apnakart.com

# -------------------------------------------------------------------------
# 2. Database Systems
# -------------------------------------------------------------------------
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/apnakart?retryWrites=true&w=majority
REDIS_URL=redis://default:<password>@redis-cloud-host:6379

# -------------------------------------------------------------------------
# 3. Security & JWT Session Signatures
# -------------------------------------------------------------------------
# Generate secure 64-character hex strings: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=your_jwt_access_secret_token_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_token_key_here

# -------------------------------------------------------------------------
# 4. Social Single-Sign-On (OAuth)
# -------------------------------------------------------------------------
# Google Developer Console Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# GitHub Settings Developers OAuth App
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# -------------------------------------------------------------------------
# 5. Payment Gateways API Keys
# -------------------------------------------------------------------------
# Stripe Settings
STRIPE_API_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Razorpay Settings
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# -------------------------------------------------------------------------
# 6. Messaging & Notifications Dispatchers
# -------------------------------------------------------------------------
# Twilio SMS
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1...

# Meta Graph API (WhatsApp Business template updates)
WHATSAPP_API_TOKEN=EA...
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here

# Firebase Cloud Messaging (Push notifications)
FCM_SERVER_KEY=your_fcm_server_key_here

# -------------------------------------------------------------------------
# 7. AI Services & Pluggable RAG Vector Indexes
# -------------------------------------------------------------------------
# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI
OPENAI_API_KEY=sk-proj-...

# Pluggable Vector Search Provider ('pinecone' | 'chromadb' | 'mongodb_atlas' | 'sandbox')
VECTOR_SEARCH_PROVIDER=pinecone

# Pinecone Credentials
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENV=your_pinecone_env_here
PINECONE_INDEX_NAME=apnakart-embeddings

# ChromaDB Host URL (if vector provider is 'chromadb')
CHROMADB_HOST=http://chromadb-service:8000

# -------------------------------------------------------------------------
# 8. Observability & Monitoring
# -------------------------------------------------------------------------
SENTRY_DSN=https://your_sentry_dsn_here

# -------------------------------------------------------------------------
# 9. Frontend & Admin Variables (Vite client build-time injected prefix VITE_)
# -------------------------------------------------------------------------
VITE_API_URL=https://api.apnakart.com
VITE_FRONTEND_URL=https://apnakart.com
