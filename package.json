{
  "name": "apnakart-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend",
    "admin"
  ],
  "scripts": {
    "install:all": "npm install",
    "backend:dev": "npm run dev --workspace=backend",
    "frontend:dev": "npm run dev --workspace=frontend",
    "admin:dev": "npm run dev --workspace=admin",
    "backend:build": "npm run build --workspace=backend",
    "frontend:build": "npm run build --workspace=frontend",
    "admin:build": "npm run build --workspace=admin",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "eslint": "^9.0.0",
    "jest": "^30.4.2",
    "prettier": "^3.2.5",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11"
  }
}
